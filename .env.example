# ============================================================
# Udemy Course Finder — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ---------- PostgreSQL ----------
# Database credentials for the PostgreSQL container
POSTGRES_USER=udemy_finder
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=udemy_finder
# Connection string (references the variables above for Docker networking)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ---------- Redis ----------
# Redis host and port for BullMQ job queue and caching
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---------- JWT ----------
# IMPORTANT: Change these to long random strings (min 32 chars)
# Generate with: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
# Access token lifetime (short-lived for security)
JWT_EXPIRY=15m
# Refresh token lifetime (long-lived, stored in Redis blacklist on logout)
JWT_REFRESH_EXPIRY=7d

# ---------- Default Admin User (seeded on first run) ----------
# These credentials are used by `prisma db seed` to create the initial admin
DEFAULT_ADMIN_EMAIL=admin@localhost.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# ---------- pgAdmin (optional database GUI) ----------
PGADMIN_DEFAULT_EMAIL=admin@localhost
PGADMIN_DEFAULT_PASSWORD=admin

# ---------- Scraper ----------
# How often the automatic scrape job runs (in minutes)
SCRAPE_INTERVAL_MINUTES=30
# Delay between HTTP requests to avoid rate limiting by source sites
SCRAPE_DELAY_SECONDS=2
# Whether to validate that extracted URLs are real Udemy courses
VALIDATE_URLS=true
# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Number of retries for failed HTTP requests
MAX_RETRIES=3
# Default HTTP timeout for scraper requests (in milliseconds)
DEFAULT_TIMEOUT_MS=30000

# ---------- Backend ----------
# Port the NestJS API listens on
BACKEND_PORT=4000
# Environment: 'development' for pretty logs, 'production' for JSON logs
NODE_ENV=development

# ---------- Frontend ----------
# The URL the frontend uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:4000
